{
  "version": 2,
  "size": 512,
  "seed": 7,
  "nodes": {
    "base": { "type": "blend", "inputs": { "a": "worn", "b": "dirt_colour", "mask": "dirt" }, "params": { "mode": "mix" } },
    "base_out": { "type": "output", "inputs": { "in": "base" }, "params": { "role": "base_colour" } },
    "bright": { "type": "gradient_map", "inputs": { "in": "grain" }, "params": { "colours": ["#cfd3d7", "#eef0f2"], "positions": [0, 1] } },
    "curv": { "type": "mesh_curvature", "params": { "width": 0.02 } },
    "dirt": { "type": "blend", "inputs": { "a": "dirt_raw", "b": "steel_only" }, "params": { "mode": "multiply" } },
    "dirt_colour": { "type": "gradient_map", "inputs": { "in": "grain" }, "params": { "colours": ["#16130f", "#2a2620"], "positions": [0, 1] } },
    "dirt_raw": { "type": "levels", "inputs": { "in": "occ" }, "params": { "in_high": 1, "in_low": 0.5, "out_high": 0, "out_low": 1 } },
    "dull": { "type": "gradient_map", "inputs": { "in": "grain" }, "params": { "colours": ["#64686d", "#7d8187"], "positions": [0, 1] } },
    "grain": { "type": "fbm", "params": { "basis": "value", "cells": [48, 48], "octaves": 3, "seed": 9 } },
    "occ": { "type": "mesh_occlusion", "params": { "rays": 32, "reach": 0.035 } },
    "rim": { "type": "levels", "inputs": { "in": "curv" }, "params": { "in_high": 0.85, "in_low": 0.6 } },
    "steel_only": { "type": "mesh_mask", "params": { "group": "steel" } },
    "wear": { "type": "blend", "inputs": { "a": "rim", "b": "steel_only" }, "params": { "mode": "multiply" } },
    "wear_out": { "type": "output", "inputs": { "in": "wear" }, "params": { "name": "wear" } },
    "worn": { "type": "blend", "inputs": { "a": "dull", "b": "bright", "mask": "wear" }, "params": { "mode": "mix" } }
  }
}
