<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- The one engine pin. Never a literal in a .csproj. Newest published to the feed at setup. -->
    <EmpyreanVersion>0.117.0</EmpyreanVersion>
    <ModelContextProtocolVersion>2.3.0</ModelContextProtocolVersion>
    <MicrosoftExtensionsHostingVersion>10.0.13</MicrosoftExtensionsHostingVersion>
    <!-- What the engine itself depends on: the encoder of engine need 2, and a decoder for the tests. -->
    <StbImageWriteSharpVersion>1.16.7</StbImageWriteSharpVersion>
    <StbImageSharpVersion>2.30.15</StbImageSharpVersion>
    <SystemReflectionMetadataLoadContextVersion>10.0.14</SystemReflectionMetadataLoadContextVersion>
  </PropertyGroup>
</Project>
