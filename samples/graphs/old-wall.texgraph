    "occlusion_out": { "type": "output", "inputs": { "in": "wall.occlusion" }, "params": { "role": "occlusion" } },
    "roughness_out": { "type": "output", "inputs": { "in": "wall.roughness" }, "params": { "role": "roughness" } },
