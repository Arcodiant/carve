{
  "version": 1,
  "size": 256,
  "seed": 138,
  "nodes": {
    "ao": { "type": "levels", "inputs": { "in": "height" }, "params": { "in_high": 0.5, "out_low": 0.55 } },
    "ao_out": { "type": "output", "inputs": { "in": "ao" }, "params": { "role": "occlusion" } },
    "base": { "type": "blend", "inputs": { "a": "grout", "b": "face_toned", "mask": "layout.mask" }, "params": { "mode": "mix" } },
    "base_out": { "type": "output", "inputs": { "in": "base" }, "params": { "role": "base_colour" } },
    "bevel": { "type": "distance", "inputs": { "in": "layout.mask" }, "params": { "range": 0.035, "side": "inside" } },
    "checker": { "type": "blend", "inputs": { "a": "su", "b": "su_inv", "mask": "sv" }, "params": { "mode": "mix" } },
    "face": { "type": "blend", "inputs": { "a": "glaze", "b": "ink", "mask": "print" }, "params": { "mode": "mix" } },
    "face_toned": { "type": "blend", "inputs": { "a": "face", "b": "tone" }, "params": { "mode": "multiply" } },
    "glaze": { "type": "colour", "params": { "colour": "#e2d9c6" } },
    "grain": { "type": "levels", "inputs": { "in": "grain_raw" }, "params": { "out_high": 1.08, "out_low": 0.85 } },
    "grain_raw": { "type": "noise", "params": { "cells": [64, 64], "interpolation": "smooth", "octaves": 3, "seed": 3 } },
    "grout": { "type": "blend", "inputs": { "a": "grout_raw", "b": "grain" }, "params": { "mode": "multiply" } },
    "grout_raw": { "type": "colour", "params": { "colour": "#8c857a" } },
    "gu": { "type": "gradient", "params": { "axis": "u", "repeat": 2 } },
    "gv": { "type": "gradient", "params": { "axis": "v", "repeat": 2 } },
    "height": { "type": "levels", "inputs": { "in": "bevel" }, "params": { "gamma": 0.7 } },
    "height_out": { "type": "output", "inputs": { "in": "height" }, "params": { "role": "height" } },
    "ink": { "type": "colour", "params": { "colour": "#2d4c78" } },
    "layout": { "type": "tiles", "params": { "bevel": 0, "count": [4, 4], "gap": 0.06 } },
    "motif": { "type": "shape", "params": { "count": [4, 4], "kind": "polygon", "sides": 3, "size": 0.55, "softness": 0.12 } },
    "motif_turned": { "type": "transform", "inputs": { "in": "motif" }, "params": { "rotation": 90 } },
    "normal": { "type": "height_to_normal", "inputs": { "height": "height" }, "params": { "strength": 0.015 } },
    "normal_out": { "type": "output", "inputs": { "in": "normal" }, "params": { "role": "normal" } },
    "print": { "type": "blend", "inputs": { "a": "motif", "b": "motif_turned", "mask": "checker" }, "params": { "mode": "mix" } },
    "rough_base": { "type": "levels", "inputs": { "in": "layout.mask" }, "params": { "out_high": 0.12, "out_low": 0.9 } },
    "roughness": { "type": "blend", "inputs": { "a": "rough_base", "b": "grain" }, "params": { "mode": "multiply" } },
    "roughness_out": { "type": "output", "inputs": { "in": "roughness" }, "params": { "role": "roughness" } },
    "su": { "type": "levels", "inputs": { "in": "gu" }, "params": { "in_high": 0.51, "in_low": 0.49 } },
    "su_inv": { "type": "levels", "inputs": { "in": "gu" }, "params": { "in_high": 0.51, "in_low": 0.49, "out_high": 0, "out_low": 1 } },
    "sv": { "type": "levels", "inputs": { "in": "gv" }, "params": { "in_high": 0.51, "in_low": 0.49 } },
    "tone": { "type": "levels", "inputs": { "in": "layout.random" }, "params": { "out_high": 1.03, "out_low": 0.95 } }
  }
}
