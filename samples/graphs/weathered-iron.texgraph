{
  "version": 2,
  "size": 256,
  "seed": 41,
  "parameters": {
    "wear_amount": { "value": 1, "drives": ["base.opacity", "rough.opacity"] }
  },
  "nodes": {
    "base": { "type": "blend", "inputs": { "a": "iron", "b": "steel", "mask": "wear" }, "params": { "mode": "mix" } },
    "base_out": { "type": "output", "inputs": { "in": "base" }, "params": { "role": "base_colour" } },
    "breakup": { "type": "levels", "inputs": { "in": "chips" }, "params": { "in_high": 0.6, "in_low": 0.3, "out_low": 0.35 } },
    "chips": { "type": "fbm", "params": { "basis": "gradient", "cells": [16, 16], "octaves": 4, "seed": 5 } },
    "curv": { "type": "mesh_curvature", "params": { "width": 0.02 } },
    "grain": { "type": "fbm", "params": { "basis": "gradient", "cells": [6, 6], "octaves": 4, "seed": 3 } },
    "iron": { "type": "gradient_map", "inputs": { "in": "grain" }, "params": { "colours": ["#787c82", "#8e9298"], "positions": [0, 1] } },
    "metal": { "type": "levels", "inputs": { "in": "grain" }, "params": { "out_high": 1, "out_low": 1 } },
    "metal_out": { "type": "output", "inputs": { "in": "metal" }, "params": { "role": "metallic" } },
    "rim": { "type": "levels", "inputs": { "in": "curv" }, "params": { "in_high": 0.85, "in_low": 0.6 } },
    "rough": { "type": "blend", "inputs": { "a": "rough_iron", "b": "rough_steel", "mask": "wear" }, "params": { "mode": "mix" } },
    "rough_iron": { "type": "levels", "inputs": { "in": "grain" }, "params": { "out_high": 0.5, "out_low": 0.4 } },
    "rough_out": { "type": "output", "inputs": { "in": "rough" }, "params": { "role": "roughness" } },
    "rough_steel": { "type": "levels", "inputs": { "in": "steel_grain" }, "params": { "out_high": 0.3, "out_low": 0.2 } },
    "steel": { "type": "gradient_map", "inputs": { "in": "steel_grain" }, "params": { "colours": ["#b4b9be", "#dde0e3"], "positions": [0, 1] } },
    "steel_grain": { "type": "fbm", "params": { "basis": "value", "cells": [48, 48], "octaves": 3, "seed": 9 } },
    "wear": { "type": "blend", "inputs": { "a": "rim", "b": "breakup" }, "params": { "mode": "multiply" } },
    "wear_out": { "type": "output", "inputs": { "in": "wear" }, "params": { "name": "wear" } }
  }
}
