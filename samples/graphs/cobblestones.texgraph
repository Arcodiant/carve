{
  "version": 1,
  "size": 256,
  "seed": 135,
  "nodes": {
    "base": { "type": "blend", "inputs": { "a": "grained", "b": "dirt", "mask": "gap" }, "params": { "mode": "mix" } },
    "base_out": { "type": "output", "inputs": { "in": "base" }, "params": { "role": "base_colour" } },
    "bend": { "type": "blend", "inputs": { "a": "bend_r", "b": "bend_g" }, "params": { "mode": "add" } },
    "bend_g": { "type": "blend", "inputs": { "a": "green", "b": "bend_v" }, "params": { "mode": "multiply" } },
    "bend_r": { "type": "blend", "inputs": { "a": "red", "b": "bend_u" }, "params": { "mode": "multiply" } },
    "bend_u": { "type": "fbm", "params": { "basis": "gradient", "cells": [4, 4], "gain": 0.55, "octaves": 4, "seed": 5 } },
    "bend_v": { "type": "fbm", "params": { "basis": "gradient", "cells": [4, 4], "gain": 0.55, "octaves": 4, "seed": 6 } },
    "dirt": { "type": "blend", "inputs": { "a": "dirt_colour", "b": "dirt_tone" }, "params": { "mode": "multiply" } },
    "dirt_colour": { "type": "colour", "params": { "colour": "#3a2f24" } },
    "dirt_raw": { "type": "fbm", "params": { "cells": [8, 8], "gain": 0.55, "octaves": 4, "seed": 9 } },
    "dirt_tone": { "type": "levels", "inputs": { "in": "dirt_raw" }, "params": { "out_high": 1.2, "out_low": 0.75 } },
    "edge": { "type": "warp", "inputs": { "by": "bend", "in": "stones.edge" }, "params": { "amount": 0.05 } },
    "gap": { "type": "levels", "inputs": { "in": "edge" }, "params": { "in_high": 0.14, "in_low": 0.04, "out_high": 0, "out_low": 1 } },
    "gap_rough": { "type": "levels", "inputs": { "in": "gap" }, "params": { "out_high": 0.95 } },
    "grain": { "type": "levels", "inputs": { "in": "grain_raw" }, "params": { "out_high": 1.1, "out_low": 0.85 } },
    "grain_raw": { "type": "fbm", "params": { "basis": "gradient", "cells": [16, 16], "gain": 0.5, "octaves": 4, "seed": 11 } },
    "grained": { "type": "blend", "inputs": { "a": "toned", "b": "grain" }, "params": { "mode": "multiply" } },
    "green": { "type": "colour", "params": { "colour": "#00ff00" } },
    "height": { "type": "levels", "inputs": { "in": "edge" }, "params": { "gamma": 1.6, "in_high": 0.65 } },
    "normal": { "type": "height_to_normal", "inputs": { "height": "height" }, "params": { "strength": 0.08 } },
    "normal_out": { "type": "output", "inputs": { "in": "normal" }, "params": { "role": "normal" } },
    "occlusion": { "type": "levels", "inputs": { "in": "height" }, "params": { "out_low": 0.3 } },
    "occlusion_out": { "type": "output", "inputs": { "in": "occlusion" }, "params": { "role": "occlusion" } },
    "red": { "type": "colour", "params": { "colour": "#ff0000" } },
    "roughness": { "type": "blend", "inputs": { "a": "stone_rough", "b": "gap_rough" }, "params": { "mode": "max" } },
    "roughness_out": { "type": "output", "inputs": { "in": "roughness" }, "params": { "role": "roughness" } },
    "stone_colour": { "type": "colour", "params": { "colour": "#8c857a" } },
    "stone_rough": { "type": "levels", "inputs": { "in": "grain_raw" }, "params": { "out_high": 0.85, "out_low": 0.6 } },
    "stones": { "type": "worley", "params": { "cells": [6, 6], "jitter": 0.85, "seed": 3 } },
    "tone": { "type": "levels", "inputs": { "in": "which" }, "params": { "out_high": 1.15, "out_low": 0.7 } },
    "toned": { "type": "blend", "inputs": { "a": "stone_colour", "b": "tone" }, "params": { "mode": "multiply" } },
    "which": { "type": "warp", "inputs": { "by": "bend", "in": "stones.random" }, "params": { "amount": 0.05 } }
  }
}
