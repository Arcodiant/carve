<Project Sdk="Microsoft.NET.Sdk">

  <!-- The debug extension: on the public API alone. Never the product, never the engine, and nothing under src/ references it. -->
  <PropertyGroup>
    <RootNamespace>Carve.Debug</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsHostingVersion)" />
    <PackageReference Include="StbImageSharp" Version="$(StbImageSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
  </ItemGroup>

</Project>
