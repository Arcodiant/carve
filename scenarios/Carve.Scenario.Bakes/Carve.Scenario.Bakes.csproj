<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bakes: the wrench opened and baked through the tools, one stage per bake in its own file, run in the order of BakesStages.cs. -->
  <PropertyGroup>
    <RootNamespace>Carve.Scenario.Bakes</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageWriteSharp" Version="$(StbImageWriteSharpVersion)" />
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" />
  </ItemGroup>

  <!-- Linked, never copied: the Uvs scenario's mesh reading, the Crate's call helpers and camera, the PNG writer, and Orcward's frame rule (D-6). -->
  <ItemGroup>
    <Compile Include="../Carve.Scenario.Uvs/UvsScene.cs" Link="UvsScene.cs" />
    <Compile Include="../Carve.Scenario.Crate/CrateBuild.cs" Link="CrateBuild.cs" />
    <Compile Include="../Carve.Scenario.Crate/CameraPixels.cs" Link="CameraPixels.cs" />
    <Compile Include="../../tools/Carve.SampleTextures/Png.cs" Link="Png.cs" />
    <Compile Include="../Carve.Scenario.Orcward/ComparisonPng.cs" Link="ComparisonPng.cs" />
    <Content Include="../../samples/wrench.carve" Link="wrench.carve" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
