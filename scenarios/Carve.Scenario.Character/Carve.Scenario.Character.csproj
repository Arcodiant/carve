<Project Sdk="Microsoft.NET.Sdk">

  <!-- The gardener: the small test character built through the real tools, posed, animated, saved, reopened and exported. -->
  <PropertyGroup>
    <RootNamespace>Carve.Scenario.Character</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The crate scenario's call helpers and its camera maths, linked and not copied. -->
    <Compile Include="../Carve.Scenario.Crate/CrateBuild.cs" Link="CrateBuild.cs" />
    <Compile Include="../Carve.Scenario.Crate/CameraPixels.cs" Link="CameraPixels.cs" />
    <Compile Include="../Carve.Scenario.Crate/ColourRule.cs" Link="ColourRule.cs" />
  </ItemGroup>

</Project>
