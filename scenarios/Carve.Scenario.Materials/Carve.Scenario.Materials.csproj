<Project Sdk="Microsoft.NET.Sdk">

  <!-- The materials: the barrel given UVs, four materials and their textures, seen in nine frames, saved, reopened and exported for the viewer. -->
  <PropertyGroup>
    <RootNamespace>Carve.Scenario.Materials</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageWriteSharp" Version="$(StbImageWriteSharpVersion)" />
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" />
  </ItemGroup>

  <!-- Linked, never copied: the Uvs scenario's mesh reading, the Crate's build and camera, and the generator that labels the textures' regions. -->
  <ItemGroup>
    <Compile Include="../Carve.Scenario.Uvs/UvsScene.cs" Link="UvsScene.cs" />
    <Compile Include="../Carve.Scenario.Crate/CrateBuild.cs" Link="CrateBuild.cs" />
    <Compile Include="../Carve.Scenario.Crate/CameraPixels.cs" Link="CameraPixels.cs" />
    <Compile Include="../../tools/Carve.SampleTextures/TextureSet.cs" Link="TextureSet.cs" />
    <Compile Include="../../tools/Carve.SampleTextures/Png.cs" Link="Png.cs" />
    <Content Include="../../samples/barrel.carve" Link="barrel.carve" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/textures/*.png" Link="textures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
