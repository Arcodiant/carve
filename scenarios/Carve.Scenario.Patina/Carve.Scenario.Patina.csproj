<Project Sdk="Microsoft.NET.Sdk">

  <!-- patina's scenario: run on the real patina (run-scenario.ps1 -Server patina), one stage per file in the order of PatinaStages.cs. -->
  <PropertyGroup>
    <RootNamespace>Carve.Scenario.Patina</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" />
    <!-- swatch's checks evaluate the graph themselves (T-114); engine-free, as patina loads it too. -->
    <ProjectReference Include="../../src/Patina.Graphs/Patina.Graphs.csproj" />
  </ItemGroup>

</Project>
