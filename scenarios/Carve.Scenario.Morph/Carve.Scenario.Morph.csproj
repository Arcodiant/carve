<Project Sdk="Microsoft.NET.Sdk">

  <!-- Morph targets (M-21): a cylinder with Bulge and Pinch seen at target weights through the real tools. T-105 adds the arm as later stages. -->
  <PropertyGroup>
    <RootNamespace>Carve.Scenario.Morph</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The crate scenario's call helpers, linked and not copied. -->
    <Compile Include="../Carve.Scenario.Crate/CrateBuild.cs" Link="CrateBuild.cs" />
    <Compile Include="../Carve.Scenario.Crate/CameraPixels.cs" Link="CameraPixels.cs" />
    <!-- Orcward's frame rule (D-6) and review image, linked and not copied (T-106). -->
    <Compile Include="../Carve.Scenario.Orcward/ComparisonPng.cs" Link="ComparisonPng.cs" />
    <Compile Include="../Carve.Scenario.Soft/NotPlanarFold.cs" Link="NotPlanarFold.cs" />
    <!-- The committed samples, which the scenario compares with what it saves. -->
    <Content Include="../../samples/arm.carve" Link="arm.carve" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../samples/arm.carve')" />
    <Content Include="../../samples/arm-lean.carve" Link="arm-lean.carve" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../samples/arm-lean.carve')" />
  </ItemGroup>

</Project>
