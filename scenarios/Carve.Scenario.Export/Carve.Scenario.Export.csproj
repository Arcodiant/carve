<Project Sdk="Microsoft.NET.Sdk">

  <!-- The export scenario: the crate saved, reopened and exported into a game's content folder. -->
  <PropertyGroup>
    <RootNamespace>Carve.Scenario.Export</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The crate's call sequence, linked and not copied: one source for both scenarios. -->
    <Compile Include="../Carve.Scenario.Crate/CrateBuild.cs" Link="CrateBuild.cs" />
  </ItemGroup>

</Project>
