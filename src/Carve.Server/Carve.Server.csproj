<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shipped product: the MCP server process. Stdout belongs to the protocol. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Carve.Server</RootNamespace>
    <AssemblyName>carve</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arcodiant.Empyrean.Animation" Version="$(EmpyreanVersion)" />
    <PackageReference Include="Arcodiant.Empyrean.Graphics" Version="$(EmpyreanVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsHostingVersion)" />
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="$(SharpGLTFVersion)" />
    <PackageReference Include="StbImageWriteSharp" Version="$(StbImageWriteSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Carve.Core/Carve.Core.csproj" />
    <ProjectReference Include="../Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../Carve.Hosting/Carve.Hosting.csproj" />
    <!-- T-223: displace evaluates a texture graph's greyscale output, as patina does (D-7). -->
    <ProjectReference Include="../Patina.Graphs/Patina.Graphs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Carve.Hosting" />
  </ItemGroup>

</Project>
