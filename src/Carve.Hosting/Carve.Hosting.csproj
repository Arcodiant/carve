<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine host both MCP servers run through (T-111): the host set-up, extension loading, the engine thread, the
       fixed sky, the texture upload rule and the offscreen render plumbing. Product code: it references no extension
       and nothing of Carve's modelling. -->
  <PropertyGroup>
    <RootNamespace>Carve.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arcodiant.Empyrean.Graphics" Version="$(EmpyreanVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsHostingVersion)" />
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Carve.Extensibility/Carve.Extensibility.csproj" />
  </ItemGroup>

</Project>
