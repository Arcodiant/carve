<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for a game: not shipped, referenced by nothing in src/, and it references no Carve project (it links one file, RenderSky.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Carve.ModelViewer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arcodiant.Empyrean.Hosting.Glfw" Version="$(EmpyreanVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not referenced: the one definition of Carve's fixed sky (T-78), in engine types only, so the sky switch lights a model as render does. -->
    <Compile Include="../../src/Carve.Server/RenderSky.cs" Link="RenderSky.cs" />
  </ItemGroup>

</Project>
