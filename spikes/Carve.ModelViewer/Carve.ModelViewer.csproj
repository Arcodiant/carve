<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for a game: not shipped, referenced by nothing in src/, and it references no Carve project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Carve.ModelViewer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arcodiant.Empyrean.Hosting.Glfw" Version="$(EmpyreanVersion)" />
    <!-- The window's weight panel (T-108): the engine's own UI labels, and the clip the Space key plays. Neither draws or runs in a headless capture. -->
    <PackageReference Include="Arcodiant.Empyrean.Ui" Version="$(EmpyreanVersion)" />
    <PackageReference Include="Arcodiant.Empyrean.Animation" Version="$(EmpyreanVersion)" />
  </ItemGroup>

</Project>
