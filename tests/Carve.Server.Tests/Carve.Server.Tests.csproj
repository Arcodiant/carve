<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Carve.Server.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)" />
    <PackageReference Include="StbImageSharp" Version="$(StbImageSharpVersion)" />
    <PackageReference Include="StbImageWriteSharp" Version="$(StbImageWriteSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Carve.Server.Tests.CarveProcess" Static="true" />
    <Using Include="Carve.Server.Tests.ToolList" Static="true" />
  </ItemGroup>

  <!--
    carve is referenced, under the alias "carve" so its types never clash with the product files linked below, for one
    reason: the unit harness (ToolHarness.cs, T-87) serves the real tools in this process through CarveServer.AddTools,
    the registration Program.cs makes. Everything else still starts carve as a real process (CarveProcess), so those
    tests see what ships; the product's own references stay guarded by ProductReferenceGuard.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Server/Carve.Server.csproj" Aliases="carve" />
  </ItemGroup>

  <!-- Built first and started as real processes, never linked. -->
  <ItemGroup>
    <ProjectReference Include="../Carve.Server.Tests.Extension/Carve.Server.Tests.Extension.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Carve.Scenario.Tiny/Carve.Scenario.Tiny.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The pure parts compile the product's file rather than linking the product; the bridge needs the engine's vertex types. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Core/Carve.Core.csproj" />
    <Compile Include="../../src/Carve.Server/ModelStore.cs" Link="ModelStore.cs" />
    <Compile Include="../../src/Carve.Server/MeshBridge.cs" Link="MeshBridge.cs" />
    <Compile Include="../../src/Carve.Server/ViewFraming.cs" Link="ViewFraming.cs" />
    <Compile Include="../../src/Carve.Server/RenderQueue.cs" Link="RenderQueue.cs" />
    <Compile Include="../../src/Carve.Server/RenderPump.cs" Link="RenderPump.cs" />
    <Compile Include="../../src/Carve.Server/WeightHeat.cs" Link="WeightHeat.cs" />
    <Compile Include="../../src/Carve.Server/LookMeshes.cs" Link="LookMeshes.cs" />
    <Compile Include="../../src/Carve.Server/CheckerTexture.cs" Link="CheckerTexture.cs" />
    <Compile Include="../../src/Carve.Server/UvLayout.cs" Link="UvLayout.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Crate/CheckerColours.cs" Link="CheckerColours.cs" />
    <Compile Include="../../src/Carve.Server/LookHolder.cs" Link="LookHolder.cs" />
    <Compile Include="../../src/Carve.Server/SheetVersions.cs" Link="SheetVersions.cs" />
    <Compile Include="../../src/Carve.Server/LabelLayout.cs" Link="LabelLayout.cs" />
    <Compile Include="../../src/Carve.Server/ScreenProjection.cs" Link="ScreenProjection.cs" />
    <Compile Include="../../src/Carve.Server/BoneOverlay.cs" Link="BoneOverlay.cs" />
    <Compile Include="../../src/Carve.Server/SheetComposer.cs" Link="SheetComposer.cs" />
    <Compile Include="../../src/Carve.Server/TargetCheck.cs" Link="TargetCheck.cs" />
    <Compile Include="../../src/Carve.Server/GlbExport.cs" Link="GlbExport.cs" />
    <!-- T-78's equality test hosts the engine in this process with Carve's own composition, lights, sky and material function. -->
    <Compile Include="../../src/Carve.Server/RenderComposition.cs" Link="RenderComposition.cs" />
    <Compile Include="../../src/Carve.Server/RenderSky.cs" Link="RenderSky.cs" />
    <Compile Include="../../src/Carve.Server/RenderLights.cs" Link="RenderLights.cs" />
    <Compile Include="../../src/Carve.Server/PbrMaterials.cs" Link="PbrMaterials.cs" />
    <Compile Include="../../src/Carve.Server/GlbRig.cs" Link="GlbRig.cs" />
    <Compile Include="../../src/Carve.Server/SkinnedExport.cs" Link="SkinnedExport.cs" />
    <Compile Include="../../src/Carve.Server/ClipsExport.cs" Link="ClipsExport.cs" />
    <Compile Include="../../src/Carve.Server/PieceExport.cs" Link="PieceExport.cs" />
    <Compile Include="../../src/Carve.Server/GlbScene.cs" Link="GlbScene.cs" />
    <Compile Include="../../src/Carve.Server/SurfaceMaterial.cs" Link="SurfaceMaterial.cs" />
    <Compile Include="../Carve.Core.Tests/TestMeshes.cs" Link="TestMeshes.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Crate/CameraPixels.cs" Link="CameraPixels.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Acceptance/Silhouette.cs" Link="Silhouette.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Orcward/GlbEdit.cs" Link="GlbEdit.cs" />
    <PackageReference Include="Arcodiant.Empyrean.Graphics" Version="$(EmpyreanVersion)" />
    <PackageReference Include="Arcodiant.Empyrean.Animation" Version="$(EmpyreanVersion)" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="$(SharpGLTFVersion)" />
    <!-- The engine parser in GlbExportTests is built from a plain service collection with logging. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsHostingVersion)" />
  </ItemGroup>

</Project>
