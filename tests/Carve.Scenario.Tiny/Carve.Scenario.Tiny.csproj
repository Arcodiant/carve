<Project Sdk="Microsoft.NET.Sdk">

  <!-- The scenario the debug extension's tests stack on it. The engine packages are only for reading the clock and the graphics residency counts back from outside the debug extension; a real scenario does not take them. -->
  <PropertyGroup>
    <RootNamespace>Carve.Scenario.Tiny</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arcodiant.Empyrean.Graphics" Version="$(EmpyreanVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
    <ProjectReference Include="../../extensions/Carve.Debug/Carve.Debug.csproj" />
  </ItemGroup>

</Project>
