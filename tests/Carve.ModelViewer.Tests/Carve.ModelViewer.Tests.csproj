<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Carve.ModelViewer.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="$(SharpGLTFVersion)" />
    <PackageReference Include="StbImageSharp" Version="$(StbImageSharpVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The panel's state and text are engine-free: the keys act on it here as they do in the window. -->
    <Compile Include="../../spikes/Carve.ModelViewer/WeightPanel.cs" Link="WeightPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first and run as a process through run-viewer.ps1; its code is not referenced. -->
    <ProjectReference Include="../../spikes/Carve.ModelViewer/Carve.ModelViewer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
