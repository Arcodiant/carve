    <ProjectReference Include="../../tools/Carve.SampleTextures/Carve.SampleTextures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../scenarios/Carve.Scenario.Shed/ShedChecks.cs" Link="Gatehouse/ShedChecks.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Shed/ShedGeometry.cs" Link="Gatehouse/ShedGeometry.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Cuts/CutsGeometry.cs" Link="Gatehouse/CutsGeometry.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Gatehouse/GatehousePlan.cs" Link="Gatehouse/GatehousePlan.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Morph/ArmPlan.cs" Link="Arm/ArmPlan.cs" />
    <Compile Include="../../scenarios/Carve.Scenario.Crate/CameraPixels.cs" Link="Arm/CameraPixels.cs" />
  </ItemGroup>

</Project>
