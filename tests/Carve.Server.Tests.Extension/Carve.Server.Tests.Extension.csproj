<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loaded by the loader tests through Carve:Extensions, on the public API alone. -->
  <PropertyGroup>
    <RootNamespace>Carve.Server.Tests.Extension</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsHostingVersion)" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="$(SystemReflectionMetadataLoadContextVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Carve.Extensibility/Carve.Extensibility.csproj" />
  </ItemGroup>

</Project>
