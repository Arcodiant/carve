<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Empyrean engine feed (BaGet, docker-compose at D:\repos\baget). -->
    <add key="empyrean-local" value="http://localhost:5555/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="empyrean-local">
      <package pattern="Arcodiant.Empyrean*" />
      <package pattern="Arcodiant.Vulkan*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
